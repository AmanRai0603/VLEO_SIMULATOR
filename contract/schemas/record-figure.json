          }
        },
        "quiet_low": {
          "type": [
            "null",
            "array"
          ],
          "description": "The lowest quiet share and its phase.",
          "items": {
            "type": "number"
          }
        },
        "mirror": {
          "type": [
            "null",
            "number"
          ],
          "description": "The correlation of the two shares across the bins."
