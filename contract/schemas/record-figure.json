          "type": "string",
          "enum": [
            "segments"
          ]
        },
        "variable": {
          "type": "string",
          "enum": [
            "ap",
            "f107"
          ]
        },
        "days": {
          "type": "number",
          "description": "Days with a value."
        },
        "refused": {
          "type": "number",
          "description": "Days the row refused to band; counted, never guessed."
        },
        "bin_width": {
          "type": "number",
          "description": "The histogram's bin width."
        },
        "counts": {
          "type": "array",
          "description": "Days in each bin from 0.",
          "items": {
            "type": "number"
          }
        },
        "max": {
          "type": [
            "null",
            "number"
          ],
          "description": "The largest value in the record."
        },
        "band_days": {
          "type": "array",
          "description": "Days in each band.",
          "items": {
            "type": "number"
          }
        },
        "band_pct": {
          "type": "array",
          "description": "Each band's share of the days banded, in per cent.",
          "items": {
            "type": "number"
          }
        },
        "below_cut": {
          "type": "array",
          "description": "At each cut, the largest value the record holds below it.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "above_cut": {
          "type": "array",
          "description": "At each cut, the smallest value the record holds above it.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "variable",
        "days",
        "refused",
        "bin_width",
        "counts",
        "max",
        "band_days",
        "band_pct",
        "below_cut",
        "above_cut"
      ]
    },
    {
      "type": "object",
      "description": "The regime-by-phase figure: the share of days at each cycle phase sw_regime calls storm, and quiet.",
