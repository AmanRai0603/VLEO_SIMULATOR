        },
        "figure": {
          "type": "string",
          "enum": [
            "growth"
          ]
        },
        "variable": {
          "type": "string",
          "enum": [
            "f107",
            "ap",
            "ssn"
          ]
        },
        "lead_years": {
          "type": "array",
          "description": "Each lead, in years.",
          "items": {
            "type": "number"
          }
        },
