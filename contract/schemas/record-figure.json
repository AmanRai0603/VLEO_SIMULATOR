{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record-figure",
  "description": "The numbers one figure of the solar-weather record states, worked out by the engine (crates/vleo-modules/src/record.rs). A number the record cannot give is null, never a stand-in.",
  "anyOf": [
    {
      "type": "object",
      "description": "The density figure: how the two drivers a density model takes sit against each other.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
        },
        "figure": {
          "type": "string",
          "enum": [
            "density"
          ]
        },
        "days": {
          "type": "number",
          "description": "Days carrying both F10.7 and Ap."
        },
        "r": {
          "type": [
            "null",
            "number"
          ],
          "description": "Pearson correlation of F10.7 with Ap; null under three days or with no spread."
        },
        "median_f107": {
          "type": [
            "null",
            "number"
          ]
        },
        "median_ap": {
          "type": [
            "null",
            "number"
          ]
        },
        "below_both_pct": {
          "type": "number",
          "description": "Per cent of those days below both medians."
        },
        "storm_ap": {
          "type": "number",
          "description": "The daily Ap at or above which a day is a storm day."
        },
        "storm_deciles": {
          "type": "number",
          "description": "How many of the ten F10.7 deciles hold at least one storm day."
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "days",
        "r",
        "median_f107",
        "median_ap",
        "below_both_pct",
        "storm_ap",
        "storm_deciles"
      ]
    },
    {
      "type": "object",
      "description": "The storm-scale figure: how storms are shared out between the cycles the record holds.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
        },
        "figure": {
          "type": "string",
          "enum": [
            "storm-scale"
          ]
        },
        "levels": {
          "type": "array",
          "description": "G1 to G3, each with its daily-Ap threshold: the published table's ap at Kp 5, 6 and 7.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "ap": {
                "type": "number"
              }
            },
            "required": [
              "name",
              "ap"
            ]
          }
        },
        "cycles": {
          "type": "array",
          "description": "The cycles, in the record's table order.",
          "items": {
            "type": "number"
          }
        },
        "days": {
          "type": "array",
          "description": "Days in each cycle carrying an Ap.",
          "items": {
            "type": "number"
          }
        },
        "max_ap": {
          "type": "array",
          "description": "The largest daily Ap in each cycle; null for a cycle with no days.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "per_year": {
          "type": "array",
          "description": "Days a year at or above each level, per cycle: [level][cycle].",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "null",
                "number"
              ]
            }
          }
        },
        "evenness": {
          "type": [
            "null",
            "number"
          ],
          "description": "The busiest cycle's G1 rate over the quietest's; null unless two cycles reach G1."
        },
        "busiest": {
          "type": "array",
          "description": "The cycle with the most days a year at each level; null where none has a rate.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "levels",
        "cycles",
        "days",
        "max_ap",
        "per_year",
        "evenness",
        "busiest"
      ]
    },
    {
      "type": "object",
      "description": "The Kp-against-Ap figure: the daily Ap at each worst three-hourly Kp, beside the published table.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
        },
        "figure": {
          "type": "string",
          "enum": [
            "kp-ap"
          ]
        },
        "kp": {
          "type": "array",
          "description": "Every worst-slot Kp the record holds, ascending.",
          "items": {
            "type": "number"
          }
        },
        "median": {
          "type": "array",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "p10": {
          "type": "array",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "p90": {
          "type": "array",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "table": {
          "type": "array",
          "description": "The published three-hourly ap at each Kp; null off the scale.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "above_median": {
          "type": "number",
          "description": "At how many of those Kp the table is above the median day."
        },
        "above_p90": {
          "type": "number",
          "description": "...and above the 90th percentile."
        },
        "kp7_table": {
          "type": [
            "null",
            "number"
          ]
        },
        "kp7_median": {
          "type": [
            "null",
            "number"
          ],
          "description": "The median day at Kp 7; null where the record has none."
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "kp",
        "median",
        "p10",
        "p90",
        "table",
        "above_median",
        "above_p90",
        "kp7_table",
        "kp7_median"
      ]
    },
    {
      "type": "object",
      "description": "The recurrence figure: the autocorrelation of the detrended record against lag, over F10.7 or Ap.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
        },
        "figure": {
          "type": "string",
          "enum": [
            "recurrence-f107",
            "recurrence-ap"
          ]
        },
        "max_lag": {
          "type": "number",
          "description": "The longest lag, in days; the curves run from lag 1 to it."
        },
        "windows": {
          "type": "array",
          "description": "The three detrend windows in days; the first is the one the rows were measured under, and the band and peaks are read off it.",
          "items": {
            "type": "number"
          }
        },
        "r": {
          "type": "array",
          "description": "The autocorrelation at every lag, one curve per window: [window][lag − 1]; null below three pairs.",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "null",
                "number"
              ]
            }
          }
        },
        "n_lag1": {
          "type": "number",
          "description": "The pairs behind the first window's correlation at lag 1."
        },
        "naive_band": {
          "type": [
            "null",
            "number"
          ],
          "description": "The naive white-noise band on that correlation, 2/sqrt(n); null with no pairs."
        },
        "band": {
          "type": "array",
          "description": "Bartlett's 95 per cent half-width on the first curve, at every lag.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "outside": {
          "type": "number",
          "description": "At how many lags the first curve is outside the band."
        },
        "peak_lag": {
          "type": "array",
          "description": "The first curve's peak lag in 18–36, 45–65 and 72–95; null where there is none.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "peak_r": {
          "type": "array",
          "description": "The correlation at each of those peaks.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "above_long": {
          "type": "number",
          "description": "At how many lags the longest window's curve sits above the first's."
        },
        "compared": {
          "type": "number",
          "description": "At how many lags both are drawn."
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "max_lag",
        "windows",
        "r",
        "n_lag1",
        "naive_band",
        "band",
        "outside",
        "peak_lag",
        "peak_r",
        "above_long",
        "compared"
      ]
    },
    {
      "type": "object",
      "description": "The spike figure: the F10.7 days the smooth cycle does not explain, and where in the cycle they fall.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
        },
        "figure": {
          "type": "string",
          "enum": [
            "spikes"
          ]
        },
        "threshold": {
          "type": [
            "null",
            "number"
          ],
          "description": "The ratio to the 81-day centred mean at which a day is a spike: the ratio's mean plus 2.5 standard deviations."
        },
        "days": {
          "type": "number",
          "description": "Spike days that have a cycle phase."
        },
        "bursts": {
          "type": "number",
          "description": "The separate runs of consecutive spike days they fall in."
        },
        "phase": {
          "type": "array",
          "description": "The centre of each phase bin.",
          "items": {
            "type": "number"
          }
        },
        "rate": {
          "type": "array",
          "description": "Spike days per thousand days at each phase; null where the record never reaches it.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "threshold",
        "days",
        "bursts",
        "phase",
        "rate"
      ]
    },
    {
      "type": "object",
      "description": "The mean-cycle figure: every cycle stacked on phase, the mean of the complete ones, and how well the last two complete cycles repeat.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
        },
        "figure": {
          "type": "string",
          "enum": [
            "mean-cycle"
          ]
        },
        "variable": {
          "type": "string",
          "enum": [
            "f107",
            "ap",
            "ssn"
          ],
          "description": "The driver stacked."
        },
        "bins": {
          "type": "number",
          "description": "How many phase bins."
        },
        "min_days": {
          "type": "number",
          "description": "The fewest days a bin must hold in both compared cycles to count toward the correlation."
        },
        "phase": {
          "type": "array",
          "description": "The centre of each phase bin.",
          "items": {
            "type": "number"
          }
        },
        "cycles": {
          "type": "array",
          "description": "The cycles, in the record's table order.",
          "items": {
            "type": "number"
          }
        },
        "complete": {
          "type": "array",
          "description": "Whether each cycle is complete; the one still running folds by the mean length of the others.",
          "items": {
            "type": "boolean"
          }
        },
        "curves": {
          "type": "array",
          "description": "Each cycle's mean in each bin: [cycle][bin]; null for an empty bin.",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "null",
                "number"
              ]
            }
          }
        },
        "mean_cycle": {
          "type": "array",
          "description": "The mean over the complete cycles of their bin means.",
          "items": {
            "type": [
              "null",
              "number"
            ]
          }
        },
        "pair": {
          "type": [
            "null",
            "array"
          ],
          "description": "The two cycles compared — the last two complete — earlier first.",
          "items": {
            "type": "number"
          }
        },
        "r": {
          "type": [
            "null",
            "number"
          ],
          "description": "Their correlation over the bins both fill; null under three."
        },
        "usable": {
          "type": "number",
          "description": "How many bins that is."
        },
        "above": {
          "type": "number",
          "description": "In how many the earlier cycle runs above the later."
        },
        "gap_rise": {
          "type": [
            "null",
            "number"
          ],
          "description": "The mean of earlier minus later before phase 0.6."
        },
        "gap_fall": {
          "type": [
            "null",
            "number"
          ],
          "description": "...and from phase 0.6."
        },
        "peak": {
          "type": [
            "null",
            "array"
          ],
          "description": "The two cycles' largest bin means.",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "ok",
        "figure",
        "bundle",
        "variable",
        "bins",
        "min_days",
        "phase",
        "cycles",
        "complete",
        "curves",
        "mean_cycle",
        "pair",
        "r",
        "usable",
        "above",
        "gap_rise",
        "gap_fall",
        "peak"
      ]
    },
    {
      "type": "object",
      "description": "The segmentation figure: where the record sits, and how much of it each band holds, banded by the rows themselves (sw_regime for Ap, sw_activity_band for F10.7).",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "bundle": {
          "type": "string",
          "description": "The bundle and version the numbers were worked out from."
