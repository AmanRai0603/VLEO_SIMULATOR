{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keys",
  "description": "The keys on this computer, in the keys folder, and whose each is.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "folder": {
      "type": "string"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "person": {
            "type": "string"
          }
        },
        "required": [
          "file",
          "person"
        ]
      }
    }
  },
  "required": [
    "ok",
    "folder",
    "keys"
  ]
}
