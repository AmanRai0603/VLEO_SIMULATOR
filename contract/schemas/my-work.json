{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "my-work",
  "description": "What needs the person whose key is open, now: a node of theirs unsigned, a group of theirs with nothing sealed, a file below them the chain refuses; and every node that is theirs to write.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "open": {
      "type": "boolean"
    },
    "name": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string"
          },
          "in": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "in"
        ]
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "unsigned",
              "no file",
              "nothing sealed",
              "refused",
              "two files",
              "request",
              "request refused",
              "start",
              "not started",
              "allocate"
            ]
          },
          "group": {
            "type": "string"
          },
          "node": {
            "type": "string"
          },
          "says": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "group",
          "node",
          "says"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "description": "Every node file that is theirs to write, or their deputy's, with one file, signed or not: what the Node workspace opens.",
      "items": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "block": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "deputy_for": {
            "type": "string",
            "description": "Whose deputy they write it as, or empty."
          },
          "signed": {
            "type": "boolean"
          }
        },
        "required": [
          "group",
          "block",
          "id",
          "revision",
          "deputy_for",
          "signed"
        ]
      }
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "ok",
    "open"
  ]
}
