{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node-file",
  "description": "A node's file in the working copy, or why not: its bytes, and what the Node workspace shows of it, which a page cannot read from the bytes.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "node": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "description": "Its path inside the copy."
    },
    "opened": {
      "type": "string",
      "description": "The SHA-256 of its bytes: what a save is held to."
    },
    "revision": {
      "type": "string"
    },
    "writer": {
      "type": "string"
    },
    "file": {
      "type": "string",
      "description": "Its bytes, as standard base64."
    },
    "group": {
      "type": "string",
      "description": "The group whose folder holds it."
    },
    "block": {
      "type": "string",
      "description": "Its block's uid."
    },
    "assigned": {
      "type": "string",
      "description": "Who its group file assigns it to; empty when nobody is, or the group file does not open."
    },
    "yours": {
      "type": "boolean",
      "description": "Whether it is the open key's person's to write: assigned to them, or to someone whose deputy they are. The program decides again at each step."
    },
    "deputy_for": {
      "type": "string",
      "description": "Whose deputy they write it as, or empty."
    },
    "signed": {
      "type": "object",
      "description": "Whether it is signed as it is now, through the chain, and in words.",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "says": {
          "type": "string"
        }
      },
      "required": [
        "ok",
        "says"
      ]
    },
    "signatures": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "signer": {
            "type": "string"
          },
          "signed_at": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          }
        },
        "required": [
          "scope",
          "revision",
          "signer",
          "signed_at",
          "verdict"
        ]
      }
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uid": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "raised_by": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "counts": {
            "type": "boolean"
          },
          "why": {
            "type": "string",
            "description": "Why it does not count, or empty."
          }
        },
        "required": [
          "uid",
          "kind",
          "status",
          "raised_by",
          "at",
          "body",
          "counts",
          "why"
        ]
      }
    },
    "findings": {
      "type": "array",
      "description": "What its own checks find, and its lesson against the design this program reads: what a signing is held to.",
      "items": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "error",
              "warning"
            ]
          },
          "place": {
            "type": "string"
          },
          "what": {
            "type": "string"
          }
        },
        "required": [
          "level",
          "place",
          "what"
        ]
      }
    },
    "changed_here": {
      "type": "boolean",
      "description": "Whether its bytes differ from what the copy was taken with."
    },
    "next": {
      "type": "string",
      "description": "The one next step, named."
    },
    "shape": {
      "type": "string",
      "enum": [
        "release",
        "design",
        "neither"
      ],
      "description": "Which shape the node file is in: a release's (its method and cases), design/'s (its sheet), or neither."
    },
    "editable": {
      "type": "boolean",
      "description": "Whether the Node workspace may write it here: it is the open key's person's, and in the release's shape."
    },
    "edit_why_not": {
      "type": "string",
      "description": "Why it cannot be written here, when it cannot."
    },
    "content": {
      "type": "object",
      "description": "What the node says, as the library reads it from the file: what the Node workspace writes (F3-g2a).",
      "properties": {
        "question": {
          "type": "string"
        },
        "explain": {
          "type": "object",
          "properties": {
            "simply": {
              "type": "string"
            },
            "breaks": {
              "type": "string"
            },
            "wrong": {
              "type": "string"
            }
          },
          "required": [
            "simply",
            "breaks",
            "wrong"
          ]
        },
        "method_text": {
          "type": "string",
          "description": "Its method, in the method language."
        },
        "case_csv": {
          "type": "string",
          "description": "Its cases: results/isolation.csv."
        },
        "declared": {
          "type": "object",
          "properties": {
            "author": {
              "type": "string"
            },
            "ai": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "checked_by": {
              "type": "string"
            }
          },
          "required": [
            "author",
            "ai",
            "source",
            "checked_by"
          ]
        },
        "versions": {
          "type": "string",
          "description": "Its own versions.csv: the record of which belief broke, a row a decision."
        }
      },
      "required": [
        "question",
        "explain",
        "method_text",
        "case_csv",
        "declared",
        "versions"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "ok"
  ]
}
