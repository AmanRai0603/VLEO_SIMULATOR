{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "node-file",
  "description": "A node's file in the working copy, or why not.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "node": {
      "type": "string"
    },
    "path": {
      "type": "string",
      "description": "Its path inside the copy."
    },
    "opened": {
      "type": "string",
      "description": "The SHA-256 of its bytes: what a save is held to."
    },
    "revision": {
      "type": "string"
    },
    "writer": {
      "type": "string"
    },
    "file": {
      "type": "string",
      "description": "Its bytes, as standard base64."
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "ok"
  ]
}
