{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "design-previewed",
  "description": "A preview written in your copy by the system engineer or their deputy: the group's release in today's design taken into the design released now, both run on the design as declared, and every value outside the group the engine answers differently; or why not.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "path": {
      "type": "string",
      "description": "The preview's path inside the copy."
    },
    "group": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "based_on": {
      "type": "string",
      "description": "The design released now, which it is on."
    },
    "named": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Each subsystem's group a value moved in, whose owner answers."
    },
    "moved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string",
            "description": "<node> or <node>.<port>, outside the release's group."
          },
          "group": {
            "type": "string",
            "description": "The group it hangs under, or the design."
          },
          "before": {
            "type": [
              "number",
              "null"
            ],
            "description": "The engine's answer on the design released now; null where it refused."
          },
          "after": {
            "type": [
              "number",
              "null"
            ],
            "description": "The engine's answer with the release in it; null where it refused."
          },
          "before_why": {
            "type": "string"
          },
          "after_why": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "group",
          "before",
          "after"
        ]
      }
    },
    "released": {
      "description": "How the design released now ran",
      "type": "object",
      "properties": {
        "ran": {
          "type": "number"
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "node",
              "why"
            ]
          }
        }
      },
      "required": [
        "ran",
        "blocked"
      ]
    },
    "with": {
      "description": "How the same design with the release in it ran",
      "type": "object",
      "properties": {
        "ran": {
          "type": "number"
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "node",
              "why"
            ]
          }
        }
      },
      "required": [
        "ran",
        "blocked"
      ]
    },
    "message": {
      "type": "string"
    }
  },
  "required": [
    "ok"
  ]
}
