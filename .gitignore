# Anchored at the root only, which missed the two crates outside the workspace:
# vleo-wasm and vleo-py build into their own target/ directories, and staging
# them adds several thousand build artefacts to a commit.
/target
**/target/
/generated
**/*.rs.bk
.DS_Store
node_modules
*.pyc
__pycache__

# The local data store, if anyone points VLEO_DATA inside a checkout. The
# devcontainer used to, and every Codespace therefore opened with ten untracked
# files that were a byte copy of bundles/ and looked like forgotten work. That
# override is gone and the store lives under $HOME again; this line is what
# stops it coming back. The store is generated -- it syncs from bundles/ when
# it opens empty -- and bundles/ is the tracked copy, the one with a manifest
# and a provenance line.
/.vleo/

# A kit built by `cargo run -p xtask -- kit`: the tool as the team gets it.
# Built, zipped and shared — never committed.
/dist/

# A node's page is rendered from its sheet when it is opened (the engine's
# /v1/fragment route, `xtask assemble` for the readers' folder). A page.html
# left in a node folder from before is read by nothing; `xtask docs` removes it.
crates/*/nodes/*/page.html
